// TotalMail: public defaults, ready to run. Keep credentials out of this file.
// Mail passwords, OAuth secrets and assistant keys are entered in the app and encrypted in database/.

name : TotalMail

// Development uses the Total.js watcher. For a hosted instance, use true, NODE_ENV=production or --release.
production : false

// Without a fixed port, Total.js uses PORT, the numeric command-line argument, then 8000.
// $port : 8000
$ip : 0.0.0.0

// The normal deployment is behind an HTTPS reverse proxy. The address that it appends to X-Forwarded-For is used only when the
// connection comes from the proxy itself (the same machine, a private or carrier-grade NAT network such as Tailscale, or link-local); from anywhere else the header is ignored. Use false
// when connecting directly without a proxy. A proxy that has a public address is named here (addresses or ranges, IPv4 or IPv6, separated
// by commas), or every client would be taken for the proxy:
// trust_proxy_from : 203.0.113.5, 198.51.100.0/24
trust_proxy : true

// Only needed when the public address cannot be inferred from the proxy's request.
// oauth_base_url : https://mail.example.com
