// TotalMail already includes a working config. This file is a reference for your installation's non-secret settings.
// Apply the settings you need to config, or mount your own config over /app/config with Docker.
// Credentials are entered in the app and encrypted in database/: never put them in a public config or commit.

name : TotalMail
production : false
// $port : 8000
$ip : 0.0.0.0
trust_proxy : true
// A proxy with a public address is named here (addresses or ranges, IPv4 or IPv6, separated by commas):
// trust_proxy_from : 203.0.113.5, 198.51.100.0/24

// oauth_base_url : https://mail.example.com
